SCHEMABRIDGE_APP_NAME=SchemaBridge
SCHEMABRIDGE_APP_VERSION=1.0.0
SCHEMABRIDGE_APP_ENVIRONMENT=development
SCHEMABRIDGE_API_PREFIX=/api/v1

SCHEMABRIDGE_MAX_UPLOAD_BYTES=20971520
SCHEMABRIDGE_MAX_RECORD_COUNT=10000
SCHEMABRIDGE_MAX_SCHEMA_FIELDS=200
SCHEMABRIDGE_MAX_RECORD_FIELDS=200
SCHEMABRIDGE_MAX_RECORD_BYTES=262144
SCHEMABRIDGE_MAX_STRING_LENGTH=100000

SCHEMABRIDGE_DEFAULT_PAGE_SIZE=50
SCHEMABRIDGE_MAX_PAGE_SIZE=200
SCHEMABRIDGE_PROFILE_DISTINCT_VALUE_LIMIT=100

SCHEMABRIDGE_DATABASE_URL=postgresql+psycopg://schemabridge:change-me@localhost:5432/schemabridge

SCHEMABRIDGE_DATABASE_POOL_SIZE=5
SCHEMABRIDGE_DATABASE_MAX_OVERFLOW=10
SCHEMABRIDGE_DATABASE_POOL_TIMEOUT_SECONDS=30
SCHEMABRIDGE_DATABASE_CONNECT_TIMEOUT_SECONDS=10
SCHEMABRIDGE_DATABASE_POOL_RECYCLE_SECONDS=1800

POSTGRES_DB=schemabridge
POSTGRES_USER=schemabridge
POSTGRES_PASSWORD=change-me

SCHEMABRIDGE_AI_API_KEY=
SCHEMABRIDGE_AI_MODEL=gpt-4.1-mini
SCHEMABRIDGE_AI_TEMPERATURE=0.0
SCHEMABRIDGE_AI_TIMEOUT_SECONDS=60
SCHEMABRIDGE_AI_MAX_RETRIES=2
SCHEMABRIDGE_AI_MAX_TOOL_CALLS=12
SCHEMABRIDGE_AI_MAX_PLAN_REVISIONS=3
SCHEMABRIDGE_AI_PROMPT_VERSION=1.0
